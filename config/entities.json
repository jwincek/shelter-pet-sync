      "fields": {
        "provider": {
          "type": "string",
          "default": "",
          "show_in_rest": false,
          "description": "Slug of the shelter platform this pet was imported from. Scopes the sync's identity lookup and stale-pet pruning so one provider's sync never touches another's pets."
        },
        "ps_id": {
          "type": "string",
          "default": "",
          "description": "Provider's record ID. Primary lookup key for sync, unique only within a provider."
        },
        "api_response": {
          "type": "string",
          "default": "",
          "show_in_rest": false,
          "description": "Full JSON snapshot of the Petstablished API response for this pet."
        },
        "api_hash": {
          "type": "string",
          "default": "",
          "show_in_rest": false,
          "description": "SHA-256 hash of the API response for change detection."
        },
        "gallery_ids": {
          "type": "attachment_ids",
          "default": [],
          "show_in_rest": true,
          "description": "Attachment IDs for a hand-curated gallery. Takes precedence over the provider snapshot's images, and unlike the snapshot carries real alt text from the media library."
        },
        "last_seen": {
          "type": "string",
          "default": "",
          "show_in_rest": false,
          "description": "Unix timestamp of the last successful fetch this pet appeared in. Written on every sync, complete or not, because presence is presence. remove_stale_pets() deliberately skips pruning when a fetch came back incomplete — right for a transient outage, but it means a withdrawn or cancelled account leaves pets published indefinitely against a frozen snapshot. This is what makes that visible."
        }
      },
