        "status": {
          "taxonomy": "pet_status",
          "show_in_summary": true
        },
        "animal": {
          "taxonomy": "pet_animal",
          "show_in_summary": true
        },
        "breed": {
          "taxonomy": "pet_breed",
          "show_in_summary": true
