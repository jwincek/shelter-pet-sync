# Files excluded from the distributed plugin zip (wp-cli dist-archive / build).
# These live in the repo but must not ship to WordPress.org.

.git
.github
.gitignore
.distignore
.wp-env.json
.DS_Store
**/.DS_Store
composer.json
composer.lock
package.json
package-lock.json
phpcs.xml.dist
# Test suite and its harness. Nothing here runs for a user.
tests
phpunit.xml.dist
phpunit-integration.xml.dist
# Written by a PHPUnit run, so it appears whenever tests ran before a build.
.phpunit.result.cache
.eslintrc.json
.stylelintrc.json
node_modules
# Generated by bin/build-dist.sh. Must be excluded or the build nests a copy of
# itself inside the output.
build
# WordPress.org listing artwork and its SVG sources. These go to the SVN
# assets/ directory, which is a sibling of trunk/ — they must never ship inside
# the plugin itself.
.wordpress-org
assets-src
# The whole vendor tree, not just vendor/bin: composer.json declares no runtime
# dependencies (require is only php >=8.1) and the plugin autoloads its own
# classes, so anything composer installs here is dev tooling — PHPCS, WPCS —
# that must never reach the zip. CI runs `composer install`, so a release built
# there would ship all of it if this were narrower.
vendor
bin
migration-scripts
README.md
CHANGELOG.md
